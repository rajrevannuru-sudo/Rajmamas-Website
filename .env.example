# Web3Forms access key for the contact form (https://web3forms.com, sent to contact@vaksconsulting.com)
PUBLIC_WEB3FORMS_KEY=

# CMS (/cms) login and storage. Set real values in Vercel → Settings → Environment Variables.
CMS_USERNAME=
CMS_PASSWORD=
# Optional extra CMS logins (up to _5). Each account can be signed in in one place at a time.
CMS_USERNAME_2=
CMS_PASSWORD_2=
# Long random string used to sign the login cookie (e.g. `openssl rand -base64 32`)
CMS_SECRET=
# GitHub fine-grained token with Contents: read & write on rajrevannuru-sudo/Rajmamas-Website
GITHUB_TOKEN=
GITHUB_REPO=rajrevannuru-sudo/Rajmamas-Website
GITHUB_BRANCH=main

# Leads database for CMS → Leads (Vercel → Storage → Upstash for Redis sets these automatically)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

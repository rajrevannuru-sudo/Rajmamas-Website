# Fill every blank value locally before importing this file in Vercel.
# Do not commit a filled copy or send it in chat.

# Web3Forms access key configured to deliver enquiries to the business email.
PUBLIC_WEB3FORMS_KEY=

# Credentials for the private /cms area.
CMS_USERNAME=
CMS_PASSWORD=
# Optional extra CMS logins (up to _5). Each account can be signed in in one place at a time.
CMS_USERNAME_2=
CMS_PASSWORD_2=
# Generate with: openssl rand -base64 32
CMS_SECRET=

# Fine-grained GitHub token, restricted to this repo with Contents read/write.
GITHUB_TOKEN=
GITHUB_REPO=rajrevannuru-sudo/Rajmamas-Website
GITHUB_BRANCH=main

# Apache (GoDaddy cPanel) config for the static build. Upload the contents of dist/ to public_html.
Options -MultiViews
ErrorDocument 404 /404.html

RewriteEngine On

# HTTPS and no www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://vaksconsulting.com%{REQUEST_URI} [L,R=301]

# Private areas: keep the CMS (/cms) and form/API endpoints (/api) out of search engines.
# (The CMS runs on Vercel; on plain Apache hosting these paths don't exist, but the headers stay in place.)
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/(cms|api)(/|$)#">
    Header always set X-Robots-Tag "noindex, nofollow"
    Header always set Cache-Control "private, no-store"
  </If>
  # Admin-style files that should never be indexed
  <FilesMatch "\.(csv|json|md)$">
    Header always set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
</IfModule>

# Block direct access to source/config files if they are ever uploaded by mistake
<FilesMatch "^(\.env.*|package(-lock)?\.json|astro\.config\.mjs|tsconfig\.json)$">
  Require all denied
</FilesMatch>

# 301 redirects from docs/seo-plan.md §6
RewriteRule ^portfolio(/.*)?$ /services [L,R=301]
RewriteRule ^theme-study/?$ / [L,R=301]
RewriteRule ^design-system/?$ / [L,R=301]
RewriteRule ^home/?$ / [L,R=301]
RewriteRule ^index\.html$ / [L,R=301]

# Clean URLs: /about.html → /about, trailing slash removed, /about served from about.html
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [L,R=301]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [L,R=301]
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

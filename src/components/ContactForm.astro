---
import Icon from './Icon.astro';
import { pages } from '../lib/site';
import { getServices } from '../lib/content';

const t = pages.contact.form;
const services = await getServices();
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
---

<div class="form-card" id="contact-form">
  <h2 id="form-h">{t.title}</h2>
  <p>{t.intro}</p>
  <form
    class="form"
    action="https://api.web3forms.com/submit"
    method="POST"
    novalidate
    aria-labelledby="form-h"
    data-error={t.error}
    data-invalid={t.invalid}
    data-success={t.success}
    data-sending={t.sending}
  >
    <input type="hidden" name="access_key" value={accessKey} />
    <input type="hidden" name="subject" value={t.subject} />
    <input type="hidden" name="from_name" value="vaksconsulting.com" />
    <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <div class="field">
      <label for="f-name">{t.name}</label>
      <input id="f-name" name="name" autocomplete="name" required />
    </div>
    <div class="field">
      <label for="f-email">{t.email}</label>
      <input id="f-email" type="email" name="email" autocomplete="email" required />
    </div>
    <div class="field full">
      <label for="f-co">{t.company} <span class="opt">{t.optional}</span></label>
      <input id="f-co" name="company" autocomplete="organization" />
    </div>
    <div class="field full">
      <label for="f-svc">{t.service}</label>
      <select id="f-svc" name="service" required>
        <option value="">{t.servicePlaceholder}</option>
        {services.map((s) => <option>{s.data.name}</option>)}
        <option>{t.notSure}</option>
      </select>
    </div>
    <div class="field full">
      <label for="f-msg">{t.details}</label>
      <textarea id="f-msg" name="message" required aria-describedby="f-msg-hint" placeholder={t.detailsPlaceholder}
      ></textarea>
      <span class="hint" id="f-msg-hint">{t.detailsHint}</span>
    </div>
    <p class="form-status full" role="status" aria-live="polite" hidden></p>
    <div class="actions">
      <p>{t.privacyNote} <a href="/privacy-policy">{t.privacyLink}</a>.</p>
      <button class="btn btn-primary" type="submit"><span class="label">{t.submit}</span> <Icon name="arrow" /></button>
    </div>
  </form>
</div>

<script>
  // Submits to Web3Forms with fetch so success and error messages show inline; falls back to a normal POST without JS.
  const form = document.querySelector<HTMLFormElement>('#contact-form form');
  if (form) {
    const status = form.querySelector<HTMLElement>('.form-status')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const label = button.querySelector<HTMLElement>('.label')!;
    const idle = label.textContent ?? '';

    const show = (kind: 'success' | 'error', msg: string) => {
      status.hidden = false;
      status.className = `form-status full ${kind}`;
      status.textContent = msg;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const invalid = [...form.querySelectorAll<HTMLInputElement>('[required]')].filter((el) => !el.checkValidity());
      form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
      if (invalid.length) {
        invalid.forEach((el) => el.setAttribute('aria-invalid', 'true'));
        invalid[0].focus();
        show('error', form.dataset.invalid ?? '');
        return;
      }
      button.disabled = true;
      label.textContent = form.dataset.sending ?? idle;
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        const json = await res.json().catch(() => ({}));
        if (!res.ok || !json.success) throw new Error(json.message ?? res.statusText);
        form.reset();
        show('success', form.dataset.success ?? '');
      } catch {
        show('error', form.dataset.error ?? '');
      } finally {
        button.disabled = false;
        label.textContent = idle;
      }
    });
  }
</script>

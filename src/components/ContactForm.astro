---
import Icon from './Icon.astro';
import Glyph from './Glyph.astro';
import { pages } from '../lib/site';
import { getServices } from '../lib/content';
import { at, src } from '../lib/cms-attr';

const t = pages.contact.form;
const services = await getServices();
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
---

<div class="form-card" id="contact-form">
  <div class="form-panel">
    <div class="form-head">
      <span class="badge"><Glyph name="send" /></span>
      <div>
        <h2 id="form-h" {...at(src('pages', 'contact.form.title'))}>{t.title}</h2>
        <p {...at(src('pages', 'contact.form.intro'))}>{t.intro}</p>
      </div>
    </div>

    <form
      class="form"
      action="https://api.web3forms.com/submit"
      method="POST"
      novalidate
      aria-labelledby="form-h"
      data-error={t.error}
      data-invalid={t.invalid}
      data-sending={t.sending}
    >
      <input type="hidden" name="access_key" value={accessKey} />
      <input type="hidden" name="subject" value={t.subject} />
      <input type="hidden" name="from_name" value="vaksconsulting.com" />
      <input type="hidden" name="service" value="" />
      <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <div class="field">
        <label for="f-name"><span {...at(src('pages', 'contact.form.name'))}>{t.name}</span><span class="req" aria-hidden="true">*</span></label>
        <div class="control">
          <Glyph name="user-round" class="control-ico" />
          <input id="f-name" name="name" autocomplete="name" placeholder={t.namePlaceholder} required aria-describedby="f-name-err" />
        </div>
        <p class="field-error" id="f-name-err" data-msg={t.errName} hidden></p>
      </div>

      <div class="field">
        <label for="f-email"><span {...at(src('pages', 'contact.form.email'))}>{t.email}</span><span class="req" aria-hidden="true">*</span></label>
        <div class="control">
          <Glyph name="mail" class="control-ico" />
          <input id="f-email" type="email" name="email" autocomplete="email" inputmode="email" placeholder={t.emailPlaceholder} required aria-describedby="f-email-err" />
        </div>
        <p class="field-error" id="f-email-err" data-msg={t.errEmail} hidden></p>
      </div>

      <div class="field full">
        <label for="f-co"><span {...at(src('pages', 'contact.form.company'))}>{t.company}</span><span class="opt">{t.optional}</span></label>
        <div class="control">
          <Glyph name="building-2" class="control-ico" />
          <input id="f-co" name="company" autocomplete="organization" placeholder={t.companyPlaceholder} />
        </div>
      </div>

      <fieldset class="field full chips-field" aria-describedby="f-svc-hint f-svc-err">
        <legend><span {...at(src('pages', 'contact.form.service'))}>{t.service}</span><span class="req" aria-hidden="true">*</span><span class="opt" id="f-svc-hint">{t.serviceHint}</span></legend>
        <div class="chips">
          {
            services.map((s) => (
              <label class="chip">
                <input type="checkbox" name="services" value={s.data.name} />
                <span class="chip-ico"><Icon name={s.data.icon} /></span>
                <span>{s.data.name}</span>
                <Glyph name="check" class="chip-check" strokeWidth={2.5} />
              </label>
            ))
          }
          <label class="chip">
            <input type="checkbox" name="services" value={t.notSure} />
            <span class="chip-ico"><Glyph name="circle-help" /></span>
            <span>{t.notSure}</span>
            <Glyph name="check" class="chip-check" strokeWidth={2.5} />
          </label>
        </div>
        <p class="field-error" id="f-svc-err" data-msg={t.errService} hidden></p>
      </fieldset>

      <div class="field full">
        <label for="f-msg"><span {...at(src('pages', 'contact.form.details'))}>{t.details}</span><span class="req" aria-hidden="true">*</span></label>
        <textarea
          id="f-msg"
          name="message"
          required
          maxlength={t.maxLength}
          aria-describedby="f-msg-hint f-msg-err"
          placeholder={t.detailsPlaceholder}></textarea>
        <div class="field-meta">
          <span class="hint" id="f-msg-hint" {...at(src('pages', 'contact.form.detailsHint'))}>{t.detailsHint}</span>
          <span class="count" aria-hidden="true"><span data-count>0</span> / {t.maxLength}</span>
        </div>
        <p class="field-error" id="f-msg-err" data-msg={t.errDetails} hidden></p>
      </div>

      <p class="form-status full" role="alert" hidden></p>

      <div class="actions">
        <p><Glyph name="shield-check" class="privacy-ico" /><span>{t.privacyNote} <a href="/privacy-policy">{t.privacyLink}</a>.</span></p>
        <button class="btn btn-primary btn-send" type="submit"><span class="label" {...at(src('pages', 'contact.form.submit'))}>{t.submit}</span><Icon name="arrow" /></button>
      </div>
    </form>
  </div>

  <div class="form-success" hidden tabindex="-1">
    <span class="success-ico"><Glyph name="check" strokeWidth={2.25} /></span>
    <h2>{t.successTitle}</h2>
    <p>{t.success}</p>
    <button class="btn btn-secondary" type="button" data-again>{t.again}</button>
  </div>
</div>

<script>
  // Inline validation, then the enquiry is saved to CMS → Leads and emailed via Web3Forms (scripts/enquiry.ts).
  // Without JS the form still posts to Web3Forms, which shows its own confirmation page.
  import { sendEnquiry } from '../scripts/enquiry';
  const card = document.querySelector<HTMLElement>('#contact-form');
  const form = card?.querySelector<HTMLFormElement>('form');
  if (card && form) {
    const panel = card.querySelector<HTMLElement>('.form-panel')!;
    const success = card.querySelector<HTMLElement>('.form-success')!;
    const status = form.querySelector<HTMLElement>('.form-status')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const label = button.querySelector<HTMLElement>('.label')!;
    const idle = label.textContent ?? '';
    const message = form.querySelector<HTMLTextAreaElement>('#f-msg')!;
    const counter = form.querySelector<HTMLElement>('[data-count]')!;
    const chipsField = form.querySelector<HTMLFieldSetElement>('.chips-field')!;
    const serviceHidden = form.querySelector<HTMLInputElement>('input[name="service"]')!;

    const setError = (el: HTMLElement, errId: string, bad: boolean) => {
      const err = document.getElementById(errId)!;
      err.hidden = !bad;
      err.textContent = bad ? (err.dataset.msg ?? '') : '';
      if (bad) el.setAttribute('aria-invalid', 'true');
      else el.removeAttribute('aria-invalid');
      el.closest('.field')?.classList.toggle('has-error', bad);
    };

    const checks: [HTMLElement, string, () => boolean][] = [
      [form.querySelector('#f-name')!, 'f-name-err', () => !!(form.querySelector<HTMLInputElement>('#f-name')!.value.trim())],
      [form.querySelector('#f-email')!, 'f-email-err', () => {
        const el = form.querySelector<HTMLInputElement>('#f-email')!;
        return !!el.value.trim() && el.checkValidity();
      }],
      [chipsField, 'f-svc-err', () => !!form.querySelector('input[name="services"]:checked')],
      [message, 'f-msg-err', () => !!message.value.trim()],
    ];

    // Re-check a field once the visitor has been told about it
    checks.forEach(([el, id, ok]) => {
      el.addEventListener(el === chipsField ? 'change' : 'input', () => {
        if (el.getAttribute('aria-invalid') === 'true') setError(el, id, !ok());
      });
      if (el !== chipsField) el.addEventListener('blur', () => {
        if ((el as HTMLInputElement).value) setError(el, id, !ok());
      });
    });

    message.addEventListener('input', () => (counter.textContent = String(message.value.length)));

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.hidden = true;
      const failed = checks.filter(([el, id, ok]) => {
        const bad = !ok();
        setError(el, id, bad);
        return bad;
      });
      if (failed.length) {
        const first = failed[0][0];
        (first === chipsField ? chipsField.querySelector<HTMLInputElement>('input')! : first).focus();
        return;
      }
      serviceHidden.value = [...form.querySelectorAll<HTMLInputElement>('input[name="services"]:checked')].map((c) => c.value).join(', ');
      button.disabled = true;
      label.textContent = form.dataset.sending ?? idle;
      try {
        const value = (sel: string) => form.querySelector<HTMLInputElement | HTMLTextAreaElement>(sel)?.value.trim() ?? '';
        const sent = await sendEnquiry(form, {
          form: 'contact',
          name: value('#f-name'),
          email: value('#f-email'),
          company: value('#f-co'),
          services: serviceHidden.value,
          message: value('#f-msg'),
        });
        if (!sent) throw new Error('not sent');
        form.reset();
        counter.textContent = '0';
        panel.hidden = true;
        success.hidden = false;
        success.focus();
      } catch {
        status.hidden = false;
        status.textContent = form.dataset.error ?? '';
      } finally {
        button.disabled = false;
        label.textContent = idle;
      }
    });

    card.querySelector('[data-again]')?.addEventListener('click', () => {
      success.hidden = true;
      panel.hidden = false;
      form.querySelector<HTMLInputElement>('#f-name')!.focus();
    });
  }
</script>

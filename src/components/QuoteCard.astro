---
import { ph } from '../lib/placeholder';
import { at, type Src } from '../lib/cms-attr';

// Name, role and company stay in content/site.json (and the CMS) but are not shown: clients are under NDA.
interface Props {
  quote: string;
  name: string;
  role: string;
  company?: string;
  quoteSrc?: Src;
  nameSrc?: Src;
  roleSrc?: Src;
}
const { quote, quoteSrc } = Astro.props;
---

<figure class="card quote-card">
  <div class="mark" aria-hidden="true">“</div>
  <blockquote {...at(quoteSrc)} set:html={ph(quote)} />
</figure>

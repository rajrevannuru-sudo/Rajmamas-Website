---
import Glyph from './Glyph.astro';
import { ph } from '../lib/placeholder';

interface Props {
  n: number;
  title: string;
  text: string;
  icon?: string;
}
const { n, title, text, icon } = Astro.props;
---

<li class="card problem-card">
  <div class:list={['num', { 'has-badge': icon }]} aria-hidden="true">
    {icon && <span class="badge"><Glyph name={icon} /></span>}
    <span class="num-n">{String(n).padStart(2, '0')}</span>
  </div>
  <h3 set:html={ph(title)} />
  <p class="muted" set:html={ph(text)} />
</li>

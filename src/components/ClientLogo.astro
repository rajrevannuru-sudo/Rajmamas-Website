---
// A client's logo (from site.json clientLogos → src/assets/images/clients/), or its name as text when no logo exists.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '../lib/site';

interface Props {
  name: string;
  /** Rendered logo height in px; width follows the logo's aspect ratio. */
  height?: number;
  /** Sit the logo on a light plate (for dark backgrounds). */
  plate?: boolean;
  class?: string;
  eager?: boolean;
}
const { name, height: baseHeight = 32, plate = false, class: className, eager = false } = Astro.props;
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/images/clients/*.{png,jpg,jpeg,webp,svg}', { eager: true });
const entry = site.clientLogos[name];
const file = typeof entry === 'string' ? entry : entry?.file;
const height = Math.round(baseHeight * (typeof entry === 'object' ? entry.scale : 1));
const src = file ? files[`../assets/images/clients/${file}`]?.default : undefined;
if (file && !src) throw new Error(`Client logo "${file}" for ${name} not found in src/assets/images/clients/`);
const width = src ? Math.round((src.width / src.height) * height) : 0;
---

{
  src ? (
    <span class:list={['client-logo', { plate }, className]}>
      <Image src={src} alt={name} height={height} width={width} densities={[1, 2]} loading={eager ? 'eager' : 'lazy'} />
    </span>
  ) : (
    <span class:list={['client-logo', 'client-logo-text', { plate }, className]}>{name}</span>
  )
}

---
import Icon from './Icon.astro';
import Button from './Button.astro';
import { site, pages } from '../lib/site';
import { ph } from '../lib/placeholder';

interface Props {
  title?: string;
}
const cta = pages.cta;
const title = Astro.props.title ?? cta.title;
---

<section class="cta-band dark" aria-labelledby="cta-h">
  <div class="wrap inner">
    <div>
      <p class="eyebrow">{cta.eyebrow}</p>
      <h2 id="cta-h" set:html={ph(title)} />
    </div>
    <div class="side">
      <p>{cta.text}</p>
      <Button href={site.bookingUrl} icon="calendar">{cta.button}</Button>
      <a class="link-arrow" href={site.whatsappHref}><Icon name="whatsapp" /><span>{cta.whatsapp}</span></a>
    </div>
  </div>
</section>

---
import Icon from './Icon.astro';
import Button from './Button.astro';
import { site, pages } from '../lib/site';
import { ph } from '../lib/placeholder';
import { at, src as s, type Src } from '../lib/cms-attr';

interface Props {
  title?: string;
  titleSrc?: Src;
}
const cta = pages.cta;
const title = Astro.props.title ?? cta.title;
---

<section class="cta-band dark" aria-labelledby="cta-h">
  <div class="wrap inner">
    <div>
      <p class="eyebrow" {...at(s('pages', 'cta.eyebrow'))}>{cta.eyebrow}</p>
      <h2 id="cta-h" {...at(Astro.props.titleSrc ?? (Astro.props.title ? undefined : s('pages', 'cta.title')))} set:html={ph(title)} />
    </div>
    <div class="side">
      <p {...at(s('pages', 'cta.text'))}>{cta.text}</p>
      <Button href={site.bookingUrl} icon="calendar">{cta.button}</Button>
      <a class="link-arrow" href={site.whatsappHref}><Icon name="whatsapp" /><span {...at(s('pages', 'cta.whatsapp'))}>{cta.whatsapp}</span></a>
    </div>
  </div>
</section>

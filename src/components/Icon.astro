---
import type { IconName } from '../lib/icons';

interface Props {
  name: IconName;
  class?: string;
  /** Accessible name; omit for decorative icons. */
  label?: string;
}

const svgs = import.meta.glob<string>('../icons/*.svg', { query: '?raw', import: 'default', eager: true });
const { name, class: className, label } = Astro.props;
const raw = svgs[`../icons/${name}.svg`];
if (!raw) throw new Error(`Unknown icon "${name}"`);

let svg = raw.replace(/ width="24" height="24"/, '').replace(/ aria-hidden="true"/, '');
const attrs = [
  className ? `class="${className}"` : '',
  label ? `role="img" aria-label="${label}"` : 'aria-hidden="true" focusable="false"',
].join(' ');
svg = svg.replace('<svg ', `<svg ${attrs} `);
---

<Fragment set:html={svg} />

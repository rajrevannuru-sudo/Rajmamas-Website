---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import HeroFlowArt from '../components/HeroFlowArt.astro';
import FounderMini from '../components/FounderMini.astro';
import SectionHead from '../components/SectionHead.astro';
import ProblemCard from '../components/ProblemCard.astro';
import ServiceCard from '../components/ServiceCard.astro';
import FounderSection from '../components/FounderSection.astro';
import Steps from '../components/Steps.astro';
import QuoteCard from '../components/QuoteCard.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, pages, testimonials } from '../lib/site';
import { ph } from '../lib/placeholder';
import { at, src } from '../lib/cms-attr';
import { getServices } from '../lib/content';

const p = pages.home;
const ui = pages.ui;
const services = await getServices();
const reassureIcons = ['shield', 'globe'] as const;
---

<BaseLayout title={p.seo.title} description={p.seo.description} path="/" og="home" headerOnDark person>
  <section class="hero dark has-diagram" aria-labelledby="h1">
    <div class="wrap grid">
      <div>
        <p class="eyebrow" {...at(src('site', 'tagline'))}>{site.tagline}</p>
        <h1 id="h1" {...at(src('pages', 'home.seo.h1'))}>{p.seo.h1}</h1>
        <p class="lead" {...at(src('pages', 'home.hero.lead'))} set:html={ph(p.hero.lead)} />
        <div class="btn-row">
          <Button href={site.bookingUrl} icon="calendar">{ui.bookCall}</Button>
          <Button href="/services" variant="secondary">{ui.allServices}</Button>
        </div>
        <p class="reassure">
          {p.hero.reassure.map((r, i) => <span><Icon name={reassureIcons[i % 2]} /><span {...at(src('pages', `home.hero.reassure.${i}`))}>{r}</span></span>)}
        </p>
      </div>
      <div class="hero-visual">
        <HeroFlowArt />
        <FounderMini />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="prob-h">
    <div class="wrap">
      <SectionHead id="prob-h" {...p.problems} src={src('pages', 'home.problems')} />
      <ul class="grid-3">
        {site.problems.map((pr, i) => <ProblemCard n={i + 1} {...pr} src={src('site', `problems.${i}`)} />)}
      </ul>
    </div>
  </section>

  <section class="section parchment" aria-labelledby="svc-h">
    <div class="wrap">
      <SectionHead id="svc-h" {...p.services} src={src('pages', 'home.services')} />
      <ul class="grid-3">
        {services.map((s) => <ServiceCard service={s} />)}
      </ul>
    </div>
  </section>

  <section class="section parchment" aria-labelledby="founder-h">
    <FounderSection variant="home" />
  </section>

  <section class="section" aria-labelledby="how-h">
    <div class="wrap">
      <SectionHead id="how-h" {...p.process} src={src('pages', 'home.process')} />
      <Steps items={site.process} label={p.process.eyebrow} src={src('site', 'process')} />
    </div>
  </section>

  {
    testimonials.length > 0 && (
      <section class="section parchment" aria-labelledby="test-h">
        <div class="wrap">
          <SectionHead id="test-h" {...p.testimonials} src={src('pages', 'home.testimonials')} />
          <ul class:list={testimonials.length === 1 ? 'quotes-single' : 'grid-3'}>
            {testimonials.map((t) => (
              <li>
                <QuoteCard
                  quote={t.quote}
                  name={t.name}
                  role={t.role}
                  company={t.company}
                  quoteSrc={src('site', `testimonials.${site.testimonials.indexOf(t)}.quote`)}
                  nameSrc={src('site', `testimonials.${site.testimonials.indexOf(t)}.name`)}
                  roleSrc={src('site', `testimonials.${site.testimonials.indexOf(t)}.role`)}
                />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section" aria-labelledby="faq-h">
    <Faq {...p.faq} items={site.homeFaq} src={src('site', 'homeFaq')} headSrc={src('pages', 'home.faq')} />
  </section>

  <CtaBand />
</BaseLayout>

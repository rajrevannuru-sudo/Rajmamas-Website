---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import FounderSection from '../components/FounderSection.astro';
import Flow from '../components/Flow.astro';
import Glyph from '../components/Glyph.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, pages } from '../lib/site';
import { ph } from '../lib/placeholder';

const p = pages.about;
---

<BaseLayout title={p.seo.title} description={p.seo.description} path="/about" og="about" person>
  <section class="page-hero dark about-hero" aria-labelledby="h1">
    <div class="wrap">
      <p class="eyebrow">{p.hero.eyebrow}</p>
      <h1 id="h1">{p.seo.h1}</h1>
    </div>
  </section>

  <section class="section" aria-labelledby="founder-h">
    <FounderSection variant="about" />
  </section>

  <section class="section parchment" aria-labelledby="story-h">
    <div class="wrap story">
      <div>
        <p class="eyebrow">{p.story.eyebrow}</p>
        <h2 id="story-h">{p.story.title}</h2>
      </div>
      <div class="prose lead story-text">
        {site.story.map((para) => <p set:html={ph(para)} />)}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="flow-h">
    <div class="wrap">
      <SectionHead id="flow-h" eyebrow={p.flow.eyebrow} title={p.flow.title} />
      <Flow items={site.projectFlow} label={p.flow.eyebrow} />
    </div>
  </section>

  <section class="section parchment" aria-labelledby="val-h">
    <div class="wrap">
      <SectionHead id="val-h" eyebrow={p.values.eyebrow} title={p.values.title} />
      <ul class="values">
        {
          site.values.map((v, i) => (
            <li class="card">
              <div class="value-head" aria-hidden="true">
                {v.icon && <span class="badge"><Glyph name={v.icon} /></span>}
                <span class="vnum">{String(i + 1).padStart(2, '0')}</span>
              </div>
              <h3>{v.title}</h3>
              <p set:html={ph(v.text)} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section dark stats-band" aria-label={p.statsLabel}>
    <ul class="wrap stats">
      {
        site.stats.map((s) => (
          <li>
            {s.icon && <span class="stat-ico" aria-hidden="true"><Glyph name={s.icon} /></span>}
            <div class="numeral"><span set:html={ph(s.value)} /><em>{s.suffix}</em></div>
            <p>{s.label}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <CtaBand />
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SectionHead from '../components/SectionHead.astro';
import Flow from '../components/Flow.astro';
import CaseCard from '../components/CaseCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, pages } from '../lib/site';
import { ph } from '../lib/placeholder';
import { breadcrumbNode, type Crumb } from '../lib/schema';
import { getCaseStudies } from '../lib/content';

const p = pages.caseStudies;
const ui = pages.ui;
const studies = await getCaseStudies();
const crumbs: Crumb[] = [
  { name: ui.home, path: '/' },
  { name: pages.caseStudy.breadcrumb, path: '/case-studies' },
];
---

<BaseLayout title={p.seo.title} description={p.seo.description} path="/case-studies" og="case-studies" schema={[breadcrumbNode(crumbs)]}>
  <section class="page-hero dark" aria-labelledby="h1">
    <div class="wrap">
      <Breadcrumbs crumbs={crumbs} />
      <p class="eyebrow">{p.hero.eyebrow}</p>
      <h1 id="h1">{p.seo.h1}</h1>
      <p class="lead lead-last" set:html={ph(p.hero.lead)} />
    </div>
  </section>

  <section class="section" aria-labelledby="flow-h">
    <div class="wrap">
      <SectionHead id="flow-h" eyebrow={p.flow.eyebrow} title={p.flow.title} />
      <Flow items={site.engagementFlow} label={p.flow.eyebrow} />
      <p class="flow-note">{p.flow.note}</p>
    </div>
  </section>

  <section class="section parchment" aria-labelledby="cases-h">
    <div class="wrap">
      <SectionHead id="cases-h" {...p.grid} />
      <ul class="grid-3">
        {studies.map((c) => <li><CaseCard study={c} /></li>)}
      </ul>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

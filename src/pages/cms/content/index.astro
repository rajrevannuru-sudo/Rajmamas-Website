---
import CmsLayout from '../../../layouts/CmsLayout.astro';
import Glyph from '../../../components/Glyph.astro';
import { isLoggedIn } from '../../../lib/cms/auth';
import { listDocs, type Doc } from '../../../lib/cms/content';

export const prerender = false;
if (!isLoggedIn(Astro.cookies)) return Astro.redirect('/cms');

let docs: Doc[] = [];
let error = '';
try {
  docs = await listDocs();
} catch (e) {
  error = String(e);
}
const groups = [
  { name: 'Site', icon: 'globe', intro: 'Text shared across the website.' },
  { name: 'Services', icon: 'briefcase', intro: 'One entry per service page.' },
  { name: 'Case studies', icon: 'trophy', intro: 'One entry per case study page.' },
];
const host = 'vaksconsulting.com';
---

<CmsLayout title="Site content" active="content">
  <div class="cms-head">
    <div>
      <h1>Site content</h1>
      <p>Edit the text on existing pages. Pages can’t be added or removed here; only blog posts can be created.</p>
    </div>
  </div>
  {error && <p class="cms-error">{error}</p>}
  <p class="cms-note">Text in <b>[square brackets]</b> shows highlighted on the site as unconfirmed. Remove the brackets once the fact is confirmed.</p>

  {
    groups.map((g) => {
      const items = docs.filter((d) => d.group === g.name);
      return (
        items.length > 0 && (
          <section class="cms-section">
            <header class="cms-section-head">
              <span class="ico"><Glyph name={g.icon} /></span>
              <div>
                <h2>{g.name}</h2>
                <p>{g.intro}</p>
              </div>
              <span class="cms-count">{items.length} {items.length === 1 ? 'item' : 'items'}</span>
            </header>
            <ul class="doc-list">
              {items.map((d) => (
                <li class="doc">
                  <div class="doc-main">
                    <a class="doc-title" href={`/cms/content/${d.id}`}>{d.label}</a>
                    {d.summary && <p class="doc-summary">{d.summary}</p>}
                    <div class="doc-urls">
                      {d.pages.map((p) => (
                        <a class="url-chip" href={p.url} target="_blank" rel="noopener" title={`Open ${p.label} in a new tab`}>
                          <Glyph name="link-2" />
                          <span class="url-host">{host}</span>
                          <span class="url-path">{p.url === '/' ? '/' : p.url}</span>
                        </a>
                      ))}
                    </div>
                  </div>
                  <div class="doc-actions">
                    <a class="cms-btn ghost sm" href={d.pages[0].url} target="_blank" rel="noopener"><Glyph name="external-link" />View page</a>
                    <a class="cms-btn sm" href={`/cms/content/${d.id}`}><Glyph name="pencil" />Edit</a>
                  </div>
                </li>
              ))}
            </ul>
          </section>
        )
      );
    })
  }
</CmsLayout>
